{
  "tool_id": "image_model_routing",
  "REQUIRED_VARIABLES": {
    "tool": [
      "IMR_SUPPORTED_IMAGE_EXTENSIONS",
      "IMR_DEFAULT_PROFILE",
      "IMR_WEIGHT_PROFILES",
      "IMR_TOKEN_TILE_PX",
      "IMR_TOKEN_BASE",
      "IMR_TOKEN_PER_TILE",
      "IMR_DEFAULT_TOKEN_ESTIMATE",
      "IMR_QUALITY_FLOOR"
    ]
  },
  "settings": {
    "IMR_TOOL_NAME": "image_model_routing",
    "IMR_TOOL_DESCRIPTION": "Routes an image input to the best vision-capable LLM based on a weighted quality/cost/latency/reliability score",

    "IMR_SUPPORTED_IMAGE_EXTENSIONS": ".png,.jpg,.jpeg,.gif,.webp,.bmp,.tiff,.tif",

    "IMR_DEFAULT_PROFILE": "balanced",
    "_IMR_WEIGHT_PROFILES_NOTE": "Weights below are final (already sum to 1 across quality/cost/latency, the only scored objectives). 'reliability_reserved' is carried for documentation only -- it is not read by the router and is excluded from scoring until a real production-reliability signal exists (see ModelCard.reliability in router.py).",
    "IMR_WEIGHT_PROFILES": "{\"balanced\": {\"quality\": 0.4375, \"cost\": 0.3125, \"latency\": 0.25, \"reliability_reserved\": 0.2}, \"quality_first\": {\"quality\": 0.75, \"cost\": 0.125, \"latency\": 0.125, \"reliability_reserved\": 0.2}, \"cost_first\": {\"quality\": 0.1765, \"cost\": 0.6471, \"latency\": 0.1765, \"reliability_reserved\": 0.15}, \"latency_first\": {\"quality\": 0.1765, \"cost\": 0.1765, \"latency\": 0.6471, \"reliability_reserved\": 0.15}}",

    "IMR_TOKEN_TILE_PX": "512",
    "IMR_TOKEN_BASE": "85",
    "IMR_TOKEN_PER_TILE": "170",
    "IMR_DEFAULT_TOKEN_ESTIMATE": "512",

    "IMR_QUALITY_FLOOR": "0.0",

    "IMR_COMPLEXITY_MIN": "0",
    "IMR_COMPLEXITY_MAX": "20",
    "IMR_COMPLEXITY_TIER_LOW_MAX": "5",
    "IMR_COMPLEXITY_TIER_MEDIUM_MAX": "10",
    "IMR_COMPLEXITY_TIER_COMPLEX_MAX": "15",
    "IMR_QUALITY_HEADROOM_BASELINE": "0.55",
    "IMR_QUALITY_DEGRADATION_FACTOR": "0.45",
    "_IMR_COMPLEXITY_WEIGHT_NOTE": "When --complexity is supplied, the profile's quality weight is shifted by (complexity_norm - PIVOT) * STRENGTH, clamped to [MIN, MAX]; cost/latency share the remainder in their original ratio. Raw complexity 10 (norm 0.5) leaves the profile unchanged. Hand-picked seed values -- tune against real outcomes.",
    "IMR_COMPLEXITY_WEIGHT_PIVOT": "0.5",
    "IMR_COMPLEXITY_WEIGHT_STRENGTH": "0.5",
    "IMR_COMPLEXITY_WEIGHT_MIN": "0.05",
    "IMR_COMPLEXITY_WEIGHT_MAX": "0.95",

    "IMR_BENCHMARK_DIR": "../../../Input/Frontier_Curve_Benchmark",
    "IMR_BENCHMARK_FILES": "{\"bol\": \"BoL.xlsx\", \"awb\": \"AWB.xlsx\", \"accord\": \"Accord.xlsx\", \"other\": \"Combined.xlsx\"}",
    "IMR_DEFAULT_RELIABILITY": "0.98",
    "IMR_COST_PLACEHOLDER_PER_1K_USD": "0.0",

    "IMR_DEFAULT_EXPECTED_OUTPUT_TOKENS": "512",
    "IMR_CONTEXT_HEADROOM_FACTOR": "1.05",

    "IMR_ERROR_SUCCESS_KEY": "success",
    "IMR_ERROR_TOOL_KEY": "tool",
    "IMR_ERROR_DATA_KEY": "data",
    "IMR_ERROR_ERROR_KEY": "error",
    "IMR_ERROR_ERROR_TYPE_KEY": "error_type",
    "IMR_ERROR_CONTEXT_KEY": "context"
  }
}
